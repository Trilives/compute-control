[Unit]
Description=Compute Control persistent task worker
Wants=network-online.target
After=network-online.target compute-control-web.service

[Service]
Type=simple
User=compute-control
Group=compute-control
WorkingDirectory=/opt/compute-control/current
ExecStart=/opt/compute-control/current/.venv/bin/compute-control --config /etc/compute-control/config.toml worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=7600
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
StateDirectory=compute-control-console
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/compute-control-console
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
