      "args": [
        "--version"
      ]
    },
    {
      "key": "gdb",
      "label": "GDB",
      "candidates": [
        "gdb"
      ],
      "args": [
        "--version"
      ]
    },
    {
      "key": "system-python",
      "label": "Python（系统版本）",
      "candidates": [
        "/usr/bin/python3",
        "/bin/python3"
      ],
      "args": [
        "--version"
      ]
    },
    {
      "key": "cuda",
      "label": "CUDA Toolkit",
      "candidates": [
        "/usr/local/cuda/bin/nvcc",
        "nvcc"
      ],
      "args": [
        "--version"
      ],
      "version_contains": "release"
    },
    {
      "key": "nvidia-driver",
      "label": "NVIDIA 驱动",
      "candidates": [
        "nvidia-smi"
      ],
      "args": [
        "--query-gpu=driver_version",
        "--format=csv,noheader"
      ],
      "version_must_succeed": true
    }
  ]
