      "label": "Make",
      "candidates": [
        "make"
      ],
      "args": [
        "--version"
      ]
    },
    {
      "key": "cmake",
      "label": "CMake",
      "candidates": [
        "cmake"
      ],
      "args": [
        "--version"
      ]
    },
    {
      "key": "ninja",
      "label": "Ninja",
      "candidates": [
        "ninja",
        "ninja-build"
